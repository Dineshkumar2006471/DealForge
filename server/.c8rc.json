{
  "all": true,
  "include": [
    "src/lib/policy/**/*.js",
    "src/lib/schema/**/*.js",
    "src/lib/security/**/*.js",
    "src/lib/evidence/**/*.js",
    "src/lib/tools/**/*.js",
    "src/lib/logger.js",
    "src/lib/config.js"
  ],
  "exclude": [
    "test/**",
    "**/*.test.js",
    "node_modules/**"
  ],
  "reporter": [
    "text",
    "text-summary",
    "lcov",
    "json-summary"
  ],
  "reports-dir": "./coverage"
}
