{
  "name": "dealforge",
  "private": true,
  "workspaces": [
    "server",
    "frontend"
  ],
  "scripts": {
    "lint": "eslint server/src/ server/test/ frontend/src/",
    "lint:frontend": "eslint frontend/src/",
    "lint:fix": "eslint --fix server/src/ server/test/ frontend/src/",
    "format": "prettier --write \"server/src/**/*.js\" \"server/test/**/*.js\" \"frontend/src/**/*.{js,jsx,css,html}\"",
    "format:check": "prettier --check \"server/src/**/*.js\" \"server/test/**/*.js\" \"frontend/src/**/*.{js,jsx,css,html}\"",
    "typecheck": "npm run typecheck --workspace=server",
    "build:frontend": "npm run build --workspace=frontend",
    "prepare": "node -e \"if (!process.env.CI && !process.env.GITHUB_ACTIONS) { try { require('child_process').execSync('npx husky', { stdio: 'inherit' }); } catch {} }\""
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "eslint": "^9.27.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.5.3"
  }
}
